#!/bin/sh
# Installed from fsi-app/.discipline/hooks/pre-push
# The push gate, three steps (HOOK-1, 2026-10-11, ADR-040 second amendment). CI's static job is where every
# other check runs (ci.yml: the rules engine, the discipline suite, the meta-gates, the fitness runner, the
# npm-dependent suites, the goldens, tsc); this hook keeps only what a machine can catch before a push leaves it
# and what costs seconds:
#   A. refuse the push when the gate itself or a critical surface is not what git will carry:
#        0d  a tracked hook file has uncommitted changes (the hook that runs is the working-tree copy);
#        1   an untracked file sits in a critical surface (the migration-067 class: present locally, absent in CI).
#      A runs on EVERY push, WIP save-points included.
#   B. on a CI-triggering push (step 0e: the tip commit carries no skip token): ESLint (max-warnings 0) on the
#      files changed against origin/master, and the unit tests (*.test.mjs) of the changed test files plus the
#      test files beside a changed module that name it. B is what a metered CI minute would otherwise find.
#   C. on a CI-triggering push: the memory gate (code must not outrun the vault), the SAME script CI runs.
# A WIP push (tip carries a skip token), a branch deletion and an empty push run only A.
#
# History: added 2026-05-21 after four failure emails in ninety minutes; D19 (2026-09-13) the stale-copy refusal;
# ADR-040 (2026-10-03) the heavy steps stopped running by default; GATE-PUSH-1 (2026-10-11) the final-push tier;
# HOOK-1 (2026-10-11) the consistency runner, the discipline suite, the meta-gates, the fitness runner, the
# npm-dependent suites, the goldens, the closure and skill-map gates, tsc, the docs-only classifier and the
# DISCIPLINE_PREPUSH_FULL opt-in are DELETED from the hook. Rule 17 (COMMON) has a lane run the fitness runner
# itself before its one final push; CI runs it again on the PR.
#
# Firing log: every step failure appends one JSON line to fsi-app/.discipline/governance/.hook-firings.log
# (gitignored, the same file the commit rules engine writes), and every push that the hook lets through appends
# one line with verdict "pass" naming the tier and the steps that ran, so the last firing is always knowable.
#
# Emergency bypass: git push --no-verify
# (Use sparingly; the whole point of the hook is to prevent the bypass-then-fix loop.)
#
# Exit codes:
#   0  all checks pass; push proceeds
#   1  at least one check failed; push blocked
#   2  hook itself errored (missing node, etc.); push BLOCKED for safety (fail-closed)

set -u

# ---------------------------------------------------------------------------
# Step 0: refuse to run as a stale copy (D19)
# ---------------------------------------------------------------------------
# install-hooks.mjs writes a TRAMPOLINE to .git/hooks/pre-push that execs THIS tracked file from the pushing
# worktree's own top level, so this file is always what actually runs. DISCIPLINE_HOOK_TRAMPOLINE is set only by
# the trampoline; its absence means this invocation did NOT come through it, i.e. this is a stale byte-for-byte
# copy from before the trampoline, and it refuses before doing anything else.
if [ -z "${DISCIPLINE_HOOK_TRAMPOLINE:-}" ]; then
  echo "[discipline pre-push] STEP 0 FAIL: stale hook copy; run node fsi-app/.discipline/install-hooks.mjs" >&2
  exit 1
fi

# A hook invoked from a LINKED WORKTREE inherits GIT_DIR (and GIT_WORK_TREE / GIT_INDEX_FILE) in its environment,
# while the same hook from the main checkout inherits none [CONFIRMED 2026-09-11 with a throwaway repo]; the
# tests this hook runs make their own fixture repositories, which an inherited GIT_DIR would redirect to the
# real one. Unset all three: git rediscovers the right repository from cwd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE

# Capture git's pre-push ref-update lines (`<local ref> <local sha> <remote ref> <remote sha>`) from stdin
# BEFORE anything consumes it. Only read when stdin is a pipe (git always provides one; a terminal would block).
if [ ! -t 0 ]; then
  PREPUSH_REFS="$(cat)"
else
  PREPUSH_REFS=""
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
  echo "[discipline pre-push] cannot resolve repo root; blocking push for safety." >&2
  exit 2
fi
cd "$REPO_ROOT" || exit 2

if ! command -v node >/dev/null 2>&1; then
  echo "[discipline pre-push] 'node' not found in PATH; blocking push for safety." >&2
  echo "[discipline pre-push] install Node.js to re-enable the push gate, or bypass with 'git push --no-verify'." >&2
  exit 2
fi

# Firing log: one JSON line {ts, rule, mode, path, line, verdict}, the same keys the commit rules engine writes
# to the same gitignored file. $1 is the rule suffix ("pre-push:<$1>"); $2 is a step log file (its first
# non-empty line is the evidence) or literal text; $3 is the verdict, "fail" unless given. 200 characters of
# evidence; never blocks the hook.
HOOK_FIRINGS_LOG="$REPO_ROOT/fsi-app/.discipline/governance/.hook-firings.log"
pre_push_log_firing() {
  if [ -f "$2" ]; then
    _ev="$(grep -m1 -v '^[[:space:]]*$' "$2" 2>/dev/null)"
  else
    _ev="$2"
  fi
  _ev="$(printf '%s' "$_ev" | tr -d '\000-\037' | cut -c1-200 | sed 's/\\/\\\\/g; s/"/\\"/g')"
  printf '{"ts":"%s","rule":"pre-push:%s","mode":"pre-push","path":"","line":"%s","verdict":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$1" "$_ev" "${3:-fail}" >> "$HOOK_FIRINGS_LOG" 2>/dev/null || true
}

# Step 0e's decision functions (is this push CI-triggering, which files B lints, which tests B runs) live in
# lib/final-push-tier.sh so a test can drive each one in a throwaway repository.
. "$REPO_ROOT/fsi-app/.discipline/hooks/lib/final-push-tier.sh"

# ---------------------------------------------------------------------------
# Step A: the gate and the critical surfaces are what git will carry (every push)
# ---------------------------------------------------------------------------
# 0d (GATE-7, register attack A-P0-3): this file is the WORKING-TREE copy, so an uncommitted edit (one that makes
# it exit 0, say) would judge the push with itself edited, and nothing pushed would carry that edit. A hook
# change takes effect by being committed, so the tracked hook files must equal HEAD's. The refusal names the
# files and the diff.
HOOK_DIRTY="$(git diff HEAD --name-only -- fsi-app/.discipline/hooks/ 2>/dev/null)"
if [ -n "$HOOK_DIRTY" ]; then
  pre_push_log_firing A "tracked hook file differs from HEAD: $(printf '%s' "$HOOK_DIRTY" | head -n 1)"
  echo "[discipline pre-push] STEP A FAIL: a tracked hook file has uncommitted changes (the hook that runs must be the one in HEAD):" >&2
  printf '%s\n' "$HOOK_DIRTY" | sed 's/^/    /' >&2
  git diff HEAD -- fsi-app/.discipline/hooks/ 2>/dev/null | head -n 60 >&2
  echo "[discipline pre-push] commit the hook change (or restore the file), then re-push." >&2
  exit 1
fi

# 1: `git ls-files --others --exclude-standard -- <patterns>` returns paths on disk that were never `git add`-ed.
# These are the surfaces where CI's checks compare disk to inventory; an untracked file in one makes the local
# checkout see something CI's cannot (the migration-067 class: the file exists locally, the CI checkout fails).
UNTRACKED_CRITICAL=$(git ls-files --others --exclude-standard \
  -- 'fsi-app/supabase/migrations/*.sql' \
     'fsi-app/src/app/api/' \
     'docs/decisions/' \
     'docs/inventories/' \
     'fsi-app/.discipline/rules/' \
     'fsi-app/.discipline/hooks/' \
     'fsi-app/.discipline/lib/' \
     'fsi-app/.discipline/fitness/functions/' \
     'fsi-app/.discipline/consistency/checks/' \
     'fsi-app/.discipline/governance/' \
     2>/dev/null)
if [ -n "$UNTRACKED_CRITICAL" ]; then
  pre_push_log_firing A "untracked critical files: $(echo "$UNTRACKED_CRITICAL" | head -n 1)"
  echo "[discipline pre-push] STEP A FAIL: untracked file(s) in critical surfaces:" >&2
  echo "$UNTRACKED_CRITICAL" | sed 's/^/    /' >&2
  echo "[discipline pre-push] CI's checkout will not see these files. Either 'git add' them or remove them, then re-push." >&2
  exit 1
fi
echo "[discipline pre-push] step A (hook unchanged, no untracked critical files): OK"

# ---------------------------------------------------------------------------
# Step 0e: is this a CI-triggering (final) push? (GATE-PUSH-1)
# ---------------------------------------------------------------------------
# A push whose tip commit (subject and body) carries no CI skip token starts a full PR run on metered Actions
# minutes, so it runs B and C before leaving the machine. A push whose tip carries a skip token (a WIP
# save-point) runs neither. A branch deletion or an empty push has no tip to judge and runs neither.
pre_push_resolve_final_push "$PREPUSH_REFS"
if [ "$PUSHED_TIPS" -eq 0 ]; then
  TIER=none
  echo "[discipline pre-push] step 0e: no pushed commit (deletion or empty push), B and C skipped"
elif [ "$FINAL_PUSH" = "true" ]; then
  TIER=final
  echo "[discipline pre-push] step 0e: final push (no skip token), running B and C"
else
  TIER=wip
  echo "[discipline pre-push] step 0e: WIP push (skip token), B and C skipped"
fi

SUMMARY="tier=$TIER A=ok"

if [ "$TIER" = "final" ]; then

  # -------------------------------------------------------------------------
  # Step B: ESLint and unit tests on what the push changes (CI-triggering push only)
  # -------------------------------------------------------------------------
  # Dependencies must resolve in THIS checkout (RD-85): a linked worktree without the shared install reports
  # false violations or hangs [CONFIRMED 2026-09-25, four lanes]. SELF-HEAL first (wt_nm_ensure_link: the one
  # shared link beside the worktrees, any junction inside the worktree removed, since `git worktree remove`
  # empties the shared install through one [CONFIRMED 2026-09-27]), then refuse, naming the cause and the fix.
  . "$REPO_ROOT/fsi-app/.discipline/hooks/lib/worktree-node-modules.sh"
  wt_nm_ensure_link || true
  if ! wt_nm_require; then
    pre_push_log_firing B "fsi-app dependencies do not resolve in this checkout"
    echo "[discipline pre-push] STEP B FAIL: the missing install above, not a lint or test failure; nothing ran." >&2
    exit 1
  fi

  # Per-run log directory (D11): `mktemp -d`, one directory per invocation, so two concurrent runs never share a
  # log path. Removed on a clean exit; kept, with its path printed, when the hook exits non-zero.
  . "$REPO_ROOT/fsi-app/.discipline/hooks/lib/prepush-logdir.sh"
  if ! pre_push_make_log_dir; then
    echo "[discipline pre-push] cannot create a per-run log directory; blocking push for safety." >&2
    exit 2
  fi
  pre_push_cleanup() {
    code="$?"
    if [ "$code" -eq 0 ]; then
      rm -rf "$PRE_PUSH_LOG_DIR"
    else
      echo "[discipline pre-push] step logs kept for diagnosis: $PRE_PUSH_LOG_DIR" >&2
    fi
  }
  trap pre_push_cleanup EXIT

  # B1: ESLint, max-warnings 0, over ONLY the files changed against origin/master (the CI command, narrowed).
  LINT_FILES="$(pre_push_changed_lintable_files)"
  LINT_FILE_COUNT="$(printf '%s' "$LINT_FILES" | grep -c . || true)"
  if [ "$LINT_FILE_COUNT" -eq 0 ]; then
    echo "[discipline pre-push] step B (eslint): no lintable files changed"
  else
    # shellcheck disable=SC2086
    if ! pre_push_eslint_files $LINT_FILES >"$PRE_PUSH_LOG_DIR/lint.log" 2>&1; then
      pre_push_log_firing B "$PRE_PUSH_LOG_DIR/lint.log"
      echo "[discipline pre-push] STEP B FAIL: ESLint reported violation(s) (max-warnings 0):" >&2
      tail -60 "$PRE_PUSH_LOG_DIR/lint.log" >&2
      echo "[discipline pre-push] full report: $PRE_PUSH_LOG_DIR/lint.log" >&2
      exit 1
    fi
    echo "[discipline pre-push] step B (eslint, max-warnings 0, $LINT_FILE_COUNT changed files): OK"
  fi

  # B2: the unit tests of the changed test files, plus the test files beside a changed module that name it.
  TEST_FILES="$(pre_push_changed_test_files)"
  TEST_FILE_COUNT="$(printf '%s' "$TEST_FILES" | grep -c . || true)"
  if [ "$TEST_FILE_COUNT" -eq 0 ]; then
    echo "[discipline pre-push] step B (unit tests): no changed test file and no test beside a changed module"
  else
    # shellcheck disable=SC2086
    if ! pre_push_run_changed_tests $TEST_FILES >"$PRE_PUSH_LOG_DIR/tests.log" 2>&1; then
      pre_push_log_firing B "$PRE_PUSH_LOG_DIR/tests.log"
      echo "[discipline pre-push] STEP B FAIL: unit tests of the changed files:" >&2
      tail -80 "$PRE_PUSH_LOG_DIR/tests.log" >&2
      echo "[discipline pre-push] full report: $PRE_PUSH_LOG_DIR/tests.log" >&2
      exit 1
    fi
    echo "[discipline pre-push] step B (unit tests, $TEST_FILE_COUNT test files): OK"
  fi

  # -------------------------------------------------------------------------
  # Step C: the memory gate, the SAME script CI runs (CI-triggering push only)
  # -------------------------------------------------------------------------
  # Code must not outrun the vault: a range that touches code without a docs/ops/session-log.d/ addendum, a
  # session-log.md change or a docs/PROGRAM-BOARD.md change fails here, not in CI (PR #647 went red there while
  # this hook was green). The range being pushed is the whole logical unit; the gate resolves its own range.
  if ! node fsi-app/.discipline/governance/memory-gate.mjs >"$PRE_PUSH_LOG_DIR/mem.log" 2>&1; then
    pre_push_log_firing C "$PRE_PUSH_LOG_DIR/mem.log"
    echo "[discipline pre-push] STEP C FAIL: memory gate (code must not outrun the vault):" >&2
    cat "$PRE_PUSH_LOG_DIR/mem.log" >&2
    echo "[discipline pre-push] append a session-log addendum (your own docs/ops/session-log.d/YYYY-MM-DD-<lane>.md file, or docs/ops/session-log.md, or update docs/PROGRAM-BOARD.md), then re-push." >&2
    exit 1
  fi
  cat "$PRE_PUSH_LOG_DIR/mem.log"
  echo "[discipline pre-push] step C (memory gate, CI parity): OK"

  SUMMARY="$SUMMARY B=ok(eslint $LINT_FILE_COUNT files, tests $TEST_FILE_COUNT files) C=ok"
fi

pre_push_log_firing push "$SUMMARY" pass
echo "[discipline pre-push] all checks pass ($SUMMARY); push proceeding."
exit 0
